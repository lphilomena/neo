{
  "schema_version": "0.5.3-splicemutr-normal-p0",
  "coordinate_contract": {
    "junction_id": "SJ|BUILD|CHR|INTRON_START_1BASED|INTRON_END_1BASED|STRAND",
    "variant_id": "VAR|BUILD|CHR|POS_1BASED|REF|ALT",
    "internal_junction_interval": "1-based closed intron",
    "approximate_fallback_allowed": false
  },
  "evidence_chains": {
    "RNA_DRIVEN": [
      "ImmunoPepper",
      "moPepGen"
    ],
    "DNA_CAUSAL": [
      "splice2neo",
      "EasyQuant",
      "pVACsplice"
    ],
    "NORMAL_BACKGROUND": [
      "coverage-aware normal panels",
      "k4neo"
    ]
  },
  "matching_policy": {
    "easyquant": "exact project query_id only",
    "k4neo": "exact project cts_id/query_id only",
    "pvacsplice": "exact variant + strand-aware junction + event",
    "mopepgen": "explicit event/junction provenance only",
    "rna_junction": "explicit junction_read_qc PASS required",
    "peptide_origin": "all required_junction_ids must pass exact RNA QC",
    "gene_or_nearest_locus_fallback": false
  },
