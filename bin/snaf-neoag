#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${NEOAG_SNAF_PYTHON:-}"
if [[ -z "${PYTHON}" ]]; then
  for candidate in \
    "${NEOAG_CONDA_BASE:-}/envs/${NEOAG_SNAF_ENV:-neoag-snaf}/bin/python" \
    "${ROOT}/tools/SNAF/.conda/bin/python"; do
    if [[ -x "${candidate}" ]]; then
      PYTHON="${candidate}"
      break
    fi
  done
fi
[[ -x "${PYTHON}" ]] || {
  echo "ERROR: SNAF Python runtime not found; set NEOAG_SNAF_PYTHON" >&2
  exit 1
}
case "${1:---help}" in
  -h|--help)
    echo "Usage: snaf-neoag doctor | python [args]"
    ;;
  doctor)
    exec "${PYTHON}" -c 'import snaf; print("SNAF runtime OK: " + snaf.__file__)'
    ;;
  python)
    shift
    exec "${PYTHON}" "$@"
    ;;
  *)
    exec "${PYTHON}" -m snaf "$@"
    ;;
esac
