#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Prefer an explicit or dependency-root HMFTOOLS environment, then the checkout-local environment.
DEPS="${NEOAG_BASIC_DEPS_DIR:-}"
for HMFTOOLS_ENV in \
  "${HMFTOOLS_CONDA:-}" \
  "${DEPS:+${DEPS}/tools/HMFTOOLS/.conda}" \
  "${ROOT}/tools/HMFTOOLS/.conda"
do
  [[ -n "${HMFTOOLS_ENV}" && -x "${HMFTOOLS_ENV}/bin/amber" ]] || continue
  exec mamba run -p "${HMFTOOLS_ENV}" amber "$@"
done
echo "ERROR: HMFTOOLS conda env not found (need tools/HMFTOOLS/.conda with amber)" >&2
exit 1
