# Copy to a site-controlled file; never commit patient paths or credentials.
export NEOAG_PYTHON=/opt/neoag-v051/bin/python
export NEOAG_BP_QUANT_BIN=/opt/neoag-v051/bin/bp_quant
export NEOAG_PVACSPLICE_BIN=/opt/neoag-v051/bin/pvacsplice
export NEOAG_PVACBIND_BIN=/opt/neoag-v051/bin/pvacbind
export NEOAG_K4NEO_BIN=/opt/neoag-v051/bin/k4neo-annotator
# Record immutable image digests/commits in every production run via --tool-version.
