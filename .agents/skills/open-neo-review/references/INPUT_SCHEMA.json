{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open-neo-review input",
  "type": "object",
  "required": ["result_dir"],
  "properties": {
    "result_dir": {"type": "string"},
    "top_n": {"type": "integer", "minimum": 1, "maximum": 100},
    "clinical_context": {"type": "string"},
    "therapy_context": {"type": "string"},
    "outdir": {"type": "string", "description": "Must differ from result_dir"}
  }
}
