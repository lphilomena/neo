{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open-neo-run input",
  "type": "object",
  "required": ["outdir"],
  "properties": {
    "outdir": {"type": "string"},
    "sample_manifest": {"type": "string"},
    "mode": {"enum": ["plan", "dry-run", "execute", "resume", "ranking-only"]},
    "automatic_tool_policy": {"enum": ["all-available", "balanced", "minimal"]},
    "approved": {"type": "boolean"},
    "input_dir": {"type": "string"},
    "tumor_dna_bam": {"type": "string"},
    "normal_dna_bam": {"type": "string"},
    "tumor_sample_id": {"type": "string"},
    "normal_sample_id": {"type": "string"},
    "tumor_rna_bam": {"type": "string"},
    "tumor_dna_fastq": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "normal_dna_fastq": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "tumor_rna_fastq": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "rna_quant_method": {"enum": ["auto", "salmon", "rsem"]},
    "salmon_index": {"type": "string"},
    "tx2gene": {"type": "string"},
    "rsem_reference": {"type": "string"},
    "star_index": {"type": "string"},
    "ctat_genome_lib": {"type": "string"},
    "easyfuse_ref": {"type": "string"},
    "normal_readthrough": {"type": "string"},
    "snaf_workflow": {"type": "string"},
    "snaf_db": {"type": "string"},
    "snaf_python": {"type": "string"},
    "altanalyze_image": {"type": "string"},
    "splicemutr_workflow": {"type": "string"},
    "rna_threads": {"type": "integer", "minimum": 1},
    "tools_manifest": {"type": "string"},
    "reference_manifest": {"type": "string"},
    "hla_file": {"type": "string"},
    "hla_alleles": {"type": "array", "items": {"type": "string"}},
    "reference_fasta": {"type": "string"},
    "gencode_gtf": {"type": "string"},
    "vep_cache": {"type": "string"},
    "normal_expression": {"type": "string"},
    "normal_hla_ligands": {"type": "string"},
    "reference_proteome": {"type": "string"},
    "normal_junctions": {"type": "string"},
    "somatic_vcf": {"type": "string"},
    "fusion_tsv": {"type": "string"},
    "splice_junction_tsv": {"type": "string"},
    "sv_vcf": {"type": ["array", "string"]},
    "capture_bed": {"type": "string"},
    "peptide_csv": {"type": "string"},
    "production_manifest": {"type": "string"},
    "result_dir": {"type": "string"},
    "comprehensive_evidence": {"type": "string"},
    "weighted_baseline": {"type": "string"},
    "expression_tsv": {"type": "string"},
    "transcript_expression_tsv": {"type": "string"},
    "rna_evidence_tsv": {"type": "string"},
    "tool_results": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}},
    "gateway_url": {"type": "string"},
    "sample_id": {"type": "string"},
    "case_root": {"type": "string"},
    "asset_root": {"type": "string"},
    "sync_public_assets": {"type": "boolean"},
    "public_asset_repo": {"type": "string"},
    "public_asset_revision": {"type": "string"},
    "public_asset_root": {"type": "string"},
    "public_asset_cache": {"type": "string"},
    "predictor_deps": {"type": "string"},
    "netmhcpan_home": {"type": "string"},
    "netmhcstabpan_home": {"type": "string"},
    "sequenza": {"type": "string"},
    "purple": {"type": "string"},
    "rna_fastq1": {"type": ["array", "string"], "items": {"type": "string"}},
    "rna_fastq2": {"type": ["array", "string"], "items": {"type": "string"}},
    "rna_bam": {"type": "string"},
    "rna_vaf": {"type": "string"},
    "star_executable": {"type": "string"},
    "samtools_executable": {"type": "string"},
    "profile": {"type": "string"},
    "evidence_consensus_rules": {"type": "string"}
    ,"event_top_n": {"type": "integer", "minimum": 1, "default": 20}
    ,"candidate_top_n": {"type": "integer", "minimum": 1, "default": 100}
  },
  "anyOf": [
    {"required": ["sample_manifest"]},
    {"required": ["case_root", "somatic_vcf", "sample_id"]},
    {"required": ["result_dir"]},
    {"required": ["comprehensive_evidence", "weighted_baseline"]},
    {"required": ["somatic_vcf"]},
    {"required": ["fusion_tsv"]},
    {"required": ["splice_junction_tsv"]},
    {"required": ["sv_vcf"]},
    {"required": ["peptide_csv"]},
    {"required": ["production_manifest"]}
    ,{"required": ["input_dir"]}
    ,{"required": ["tumor_dna_bam"]}
    ,{"required": ["tumor_dna_fastq"]}
    ,{"required": ["tumor_rna_bam"]}
    ,{"required": ["tumor_rna_fastq"]}
  ]
}
