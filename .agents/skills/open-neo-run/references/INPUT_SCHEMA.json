{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open-neo-run input",
  "type": "object",
  "properties": {
    "sample_manifest": {"type": "string"},
    "mode": {"enum": ["plan", "dry-run", "execute", "resume", "ranking-only"]},
    "approved": {"type": "boolean"},
    "input_dir": {"type": "string"},
    "tumor_dna_bam": {"type": "string"},
    "normal_dna_bam": {"type": "string"},
    "tumor_rna_bam": {"type": "string"},
    "tumor_dna_fastq": {"type": "array", "items": {"type": "string"}},
    "normal_dna_fastq": {"type": "array", "items": {"type": "string"}},
    "tumor_rna_fastq": {"type": "array", "items": {"type": "string"}},
    "rna_quant_method": {"enum": ["auto", "salmon", "rsem"]},
    "salmon_index": {"type": "string"},
    "tx2gene": {"type": "string"},
    "rsem_reference": {"type": "string"},
    "somatic_vcf": {"type": "string"},
    "fusion_tsv": {"type": "string"},
    "splice_junction_tsv": {"type": "string"},
    "sv_vcf": {"type": ["array", "string"]},
    "capture_bed": {"type": "string"},
    "peptide_csv": {"type": "string"},
    "production_manifest": {"type": "string"},
    "result_dir": {"type": "string"},
    "comprehensive_evidence": {"type": "string"},
    "weighted_baseline": {"type": "string"},
    "expression_tsv": {"type": "string"},
    "transcript_expression_tsv": {"type": "string"},
    "rna_evidence_tsv": {"type": "string"},
    "tool_results": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}},
    "gateway_url": {"type": "string"}
  },
  "anyOf": [
    {"required": ["sample_manifest"]},
    {"required": ["result_dir"]},
    {"required": ["comprehensive_evidence", "weighted_baseline"]},
    {"required": ["somatic_vcf"]},
    {"required": ["fusion_tsv"]},
    {"required": ["splice_junction_tsv"]},
    {"required": ["sv_vcf"]},
    {"required": ["peptide_csv"]},
    {"required": ["production_manifest"]}
    ,{"required": ["input_dir"]}
    ,{"required": ["tumor_dna_bam"]}
    ,{"required": ["tumor_rna_bam"]}
  ]
}
